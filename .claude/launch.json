{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", "/tmp/bp-serve", "-p", "3003", "-s", "--cors", "-c-1"],
      "port": 3003
    },
    {
      "name": "docs-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--", "--no-open", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "docs-serve",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "serve", "--", "--port", "3002", "--no-open"],
      "port": 3002
    }
  ]
}
